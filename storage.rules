rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Property images - authenticated users can upload, anyone authenticated can read
    match /property-images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size.image != null
                   && request.resource.size < 10 * 1024 * 1024; // Max 10MB per image
    }
    
    // Property videos - authenticated users can upload, anyone authenticated can read
    match /property-videos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.contentType.matches('video/.*')
                   && request.resource.size < 50 * 1024 * 1024; // Max 50MB per video
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}