{
  "expo": {
    "name": "Propify",
    "slug": "propify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-512.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/propify-splash-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propify.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.propify.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "firebaseApiKey": "AIzaSyCrAmX8-R__Baq5oTyoYq-EGLm88uKRDSo",
      "firebaseAuthDomain": "propify-faaed.firebaseapp.com",
      "firebaseProjectId": "propify-faaed",
      "firebaseStorageBucket": "propify-faaed.firebasestorage.app",
      "firebaseMessagingSenderId": "720452952998",
      "firebaseAppId": "1:720452952998:web:42099ae2f632f5ee4ae567",
      "firebaseMeasurementId": "G-12LTTC2ZHL",
      "eas": {
        "projectId": "12882287-099b-44d0-aa14-b2a2af54a1a8"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload property images."
        }
      ],
      "expo-font"
    ],
    "owner": "shailendra90"
  }
}
